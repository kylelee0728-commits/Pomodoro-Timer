<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PomodoroTimer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PomodoroTimer.Controls"
    xmlns:converters="using:PomodoroTimer.Converters"
    Title="番茄鐘">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <converters:IntDoubleConverter x:Key="IntDouble" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: draggable strip plus the settings toggle. -->
        <Grid x:Name="AppTitleBar" Height="40" Grid.Row="0" Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <!-- Only this strip is the drag region, so the settings button stays clickable. -->
            <Border x:Name="DragRegion" Grid.Column="0" Background="Transparent">
                <TextBlock Text="番茄鐘"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </Border>

            <Button Grid.Column="1"
                    x:Name="SettingsButton"
                    Click="OnToggleSettings"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="設定"
                    AutomationProperties.Name="設定">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <SplitView x:Name="Shell"
                   Grid.Row="1"
                   PanePlacement="Right"
                   DisplayMode="Overlay"
                   OpenPaneLength="320"
                   IsPaneOpen="False">

            <SplitView.Pane>
                <ScrollViewer Padding="20,12,20,20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="設定" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <NumberBox Header="專注（分鐘）"
                                       Minimum="1" Maximum="180" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.FocusMinutes, Mode=TwoWay, Converter={StaticResource IntDouble}}" />

                        <NumberBox Header="短休息（分鐘）"
                                       Minimum="1" Maximum="60" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.ShortBreakMinutes, Mode=TwoWay, Converter={StaticResource IntDouble}}" />

                        <NumberBox Header="長休息（分鐘）"
                                       Minimum="1" Maximum="120" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.LongBreakMinutes, Mode=TwoWay, Converter={StaticResource IntDouble}}" />

                        <NumberBox Header="幾個番茄後長休息"
                                       Minimum="1" Maximum="12" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.LongBreakInterval, Mode=TwoWay, Converter={StaticResource IntDouble}}" />

                        <ToggleSwitch Header="自動開始休息"
                                      IsOn="{x:Bind ViewModel.AutoStartBreaks, Mode=TwoWay}" />

                        <ToggleSwitch Header="休息後自動開始專注"
                                      IsOn="{x:Bind ViewModel.AutoStartFocus, Mode=TwoWay}" />

                        <ToggleSwitch Header="提示音"
                                      IsOn="{x:Bind ViewModel.PlaySound, Mode=TwoWay}" />

                        <ToggleSwitch Header="系統通知"
                                      IsOn="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}" />

                        <ToggleSwitch Header="視窗永遠置頂"
                                      IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" />

                        <Button Content="重設今日進度" Command="{x:Bind ViewModel.ResetCycleCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <Grid Padding="24,8,24,28" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.PhaseTitle, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               Foreground="{x:Bind ViewModel.PhaseBrush, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PhaseHint, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>

                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:RingProgress Width="{StaticResource RingSize}"
                                           Height="{StaticResource RingSize}"
                                           RingThickness="18"
                                           TrackBrush="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                                           ValueBrush="{x:Bind ViewModel.PhaseBrush, Mode=OneWay}"
                                           Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />

                    <TextBlock Text="{x:Bind ViewModel.TimeText, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="64"
                               FontWeight="SemiLight"
                               AutomationProperties.Name="剩餘時間" />
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="12">
                    <Button Command="{x:Bind ViewModel.ResetCommand}"
                            Width="48" Height="48"
                            ToolTipService.ToolTip="重設"
                            AutomationProperties.Name="重設">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="16" />
                    </Button>

                    <Button Command="{x:Bind ViewModel.StartPauseCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            MinWidth="140" Height="48"
                            AutomationProperties.Name="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="{x:Bind ViewModel.PrimaryActionGlyph, Mode=OneWay}"
                                      FontSize="16" />
                            <TextBlock Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.SkipCommand}"
                            Width="48" Height="48"
                            ToolTipService.ToolTip="跳過此階段"
                            AutomationProperties.Name="跳過此階段">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE893;" FontSize="16" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="{x:Bind ViewModel.CycleText, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
        </SplitView>
    </Grid>
</Window>
